NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_tutorial?schema=public
REDIS_URL=redis://localhost:6379

# Any random string of 32+ characters; `openssl rand -hex 32` is enough.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
# 7 days
JWT_TTL_SECONDS=604800

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:4100

# Object storage, matching the storage service in the compose file. The
# credentials below are the development defaults, not secrets.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nestjs-tutorial-public
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Ignored by the development server, required by the SDK.
S3_REGION=us-east-1

# Mail server, matching the capture service in the compose file. It delivers
# nothing; read what the API sent at http://localhost:8025.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@nestjs-tutorial.local

# Where a password reset link points. No page is served here, so this is the
# address of whichever client renders the form; the token is appended to it.
PASSWORD_RESET_URL=http://localhost:4100/password-reset
# 1 hour
PASSWORD_RESET_TTL_SECONDS=3600
