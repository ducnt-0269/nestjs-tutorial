NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_tutorial?schema=public
REDIS_URL=redis://localhost:6379

# Any random string of 32+ characters; `openssl rand -hex 32` is enough.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
# 7 days
JWT_TTL_SECONDS=604800

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:4100
