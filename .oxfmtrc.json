{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["dist/**", "coverage/**", "src/generated/**"],
  "printWidth": 80,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": {
    "groups": [
      "side_effect",
      "builtin",
      "external",
      "parent",
      ["sibling", "index"],
      "unknown"
    ]
  }
}
